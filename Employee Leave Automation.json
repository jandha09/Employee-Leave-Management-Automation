      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Leave Request Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [-1680, 0],
      "webhookId": "leave-request-form"
    },
    {
      "parameters": {
        "jsCode": "// Calculate number of business days requested (inclusive), Mon-Fri only\nconst input = $input.first().json;\n\nconst start = new Date(input['Start Date']);\nconst end = new Date(input['End Date']);\n\nif (isNaN(start) || isNaN(end) || end < start) {\n  throw new Error('Invalid date range: End Date must be on or after Start Date.');\n}\n\nlet days = 0;\nconst cursor = new Date(start);\nwhile (cursor <= end) {\n  const day = cursor.getDay();\n  if (day !== 0 && day !== 6) days++;\n  cursor.setDate(cursor.getDate() + 1);\n}\n\nconst requestId = 'LR-' + Date.now().toString(36).toUpperCase();\n\nreturn [{\n  json: {\n    requestId,\n    employeeName: input['Employee Name'],\n    employeeEmail: input['Employee Email'],\n    department: input['Department'],\n    leaveType: input['Leave Type'],\n    startDate: input['Start Date'],\n    endDate: input['End Date'],\n    reason: input['Reason'] || '',\n    managerEmail: input['Manager Email'],\n    daysRequested: days,\n    submittedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Calculate Days Requested",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1460, 0]
    },
    {
      "parameters": {
        "operation": "lookup",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leave Balances",
          "mode": "name"
        },
        "lookupColumn": "Employee Email",
        "lookupValue": "={{ $json.employeeEmail }}",
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Get Leave Balance",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-1240, 0]
    },
    {
      "parameters": {
        "jsCode": "// Merge the balance lookup with the request data and determine remaining balance\nconst request = $('Calculate Days Requested').first().json;\nconst balanceRows = $input.all();\n\nlet currentBalance = null;\nif (balanceRows.length > 0 && balanceRows[0].json && balanceRows[0].json['Remaining Balance'] !== undefined) {\n  currentBalance = Number(balanceRows[0].json['Remaining Balance']);\n}\n\n// If no record found, treat as 0 balance so it routes to manager review\nif (currentBalance === null || isNaN(currentBalance)) {\n  currentBalance = 0;\n}\n\nconst remainingAfter = currentBalance - request.daysRequested;\nconst withinBalance = request.leaveType === 'Unpaid' ? true : remainingAfter >= 0;\n\nreturn [{\n  json: {\n    ...request,\n    currentBalance,\n    remainingAfter,\n    withinBalance,\n    status: withinBalance ? 'Approved' : 'Pending Manager Review'\n  }\n}];"
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Evaluate Balance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1020, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond1",
              "leftValue": "={{ $json.withinBalance }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
